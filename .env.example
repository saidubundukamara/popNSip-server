# ── core ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://popnsip:popnsip@localhost:5433/popnsip?schema=public
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
# openssl rand -base64 32
SESSION_SECRET=
LOG_LEVEL=info

# ── monime (mobile money) ─────────────────────────────────────────────────
# Required when NODE_ENV=production.
MONIME_BASE_URL=https://api.monime.io/v1
MONIME_TOKEN=
MONIME_SPACE_ID=
MONIME_VERSION=caph.2025-08-23
MONIME_WEBHOOK_SECRET=

# ── whapi (whatsapp) ──────────────────────────────────────────────────────
# Required when NODE_ENV=production. WHAPI_NUMBER is E.164 with the leading +.
WHAPI_URL=https://gate.whapi.cloud
WHAPI_TOKEN=
WHAPI_NUMBER=

# ── cloudinary (media) ────────────────────────────────────────────────────
# Required when NODE_ENV=production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── ops ───────────────────────────────────────────────────────────────────
RESTAURANT_TIMEZONE=Africa/Freetown
# Required when NODE_ENV=production. Guards the job endpoints.
CRON_SECRET=
